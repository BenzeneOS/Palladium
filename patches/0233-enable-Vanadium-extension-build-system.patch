From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Amaan Qureshi <git@amaanq.com>
Date: Sat, 11 Jan 2026 00:00:00 +0000
Subject: [PATCH] enable Vanadium extension support build system

Port extension support patches to enable Chrome extensions on Android.
Uses is_desktop_android_vanadium flag to avoid conflicts with Google's
broken is_desktop_android implementation.

This patch modifies BUILD.gn and .gni files to enable the extension
build system on Android.
---

diff --git a/android_webview/BUILD.gn b/android_webview/BUILD.gn
index 1a7350b20494a..7879b9a1a89e8 100644
--- a/android_webview/BUILD.gn
+++ b/android_webview/BUILD.gn
@@ -1299,11 +1299,11 @@ declare_args() {
       # - WebView and Chrome x86, see https://crbug.com/967343.
       # *IMPORTANT*: The x86 and x64 architectures are used to test orderfile
       # logic more easily on an emulator, so the decision to use the arm64
       # orderfile for x64 (instead of arm32) is somewhat arbitrary. We just
       # needed to use some real orderfile.
-      if (is_desktop_android && current_cpu == "x64") {
+      if (is_desktop_android_false && current_cpu == "x64") {
         # For Android Desktop x64, orderfile is disabled, see
         # https://crbug.com/422005929.
         webview_orderfile_path = ""
       } else if (current_cpu == "arm64" || current_cpu == "x64") {
         webview_orderfile_path =
