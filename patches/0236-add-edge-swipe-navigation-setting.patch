+    private void updateEdgeSwipeNavigationSummary(String value) {
+        if (mEdgeSwipeNavigationPref == null) return;
+        int summaryResId;
+        switch (value) {
+            case EdgeSwipeNavigationUtils.MODE_DISABLED:
+                summaryResId = R.string.edge_swipe_navigation_disabled;
+                break;
+            case EdgeSwipeNavigationUtils.MODE_BACK_ONLY:
+                summaryResId = R.string.edge_swipe_navigation_back_only;
+                break;
+            case EdgeSwipeNavigationUtils.MODE_BACK_AND_FORWARD:
+            default:
+                summaryResId = R.string.edge_swipe_navigation_back_and_forward;
+                break;
+        }
+        mEdgeSwipeNavigationPref.setSummary(summaryResId);
