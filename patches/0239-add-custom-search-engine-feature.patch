@@ -0,0 +1,141 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.search_engines.settings;
+
+import android.app.Dialog;
+import android.content.Context;
+import android.os.Bundle;
+import android.text.Editable;
+import android.text.TextWatcher;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.EditText;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.fragment.app.DialogFragment;
+
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+import org.chromium.chrome.browser.search_engines.R;
+import org.chromium.chrome.browser.search_engines.TemplateUrlServiceFactory;
+import org.chromium.components.search_engines.TemplateUrlService;
+
+/**
+ * Dialog for adding a custom search engine.
+ * Users can specify name, keyword, and search URL with %s placeholder.
+ */
+@NullMarked
+public class AddCustomSearchEngineDialog extends DialogFragment {
+    private EditText mNameInput;
+    private EditText mKeywordInput;
+    private EditText mSearchUrlInput;
+    private AlertDialog mDialog;
+    private @Nullable Runnable mOnSuccessCallback;
+
+    public void setOnSuccessCallback(Runnable callback) {
+        mOnSuccessCallback = callback;
+    }
+
+    @Override
+    public Dialog onCreateDialog(@Nullable Bundle savedInstanceState) {
+        Context context = requireContext();
+        LayoutInflater inflater = LayoutInflater.from(context);
+        View view = inflater.inflate(R.layout.add_custom_search_engine_dialog, null);
+
+        mNameInput = view.findViewById(R.id.search_engine_name);
+        mKeywordInput = view.findViewById(R.id.search_engine_keyword);
+        mSearchUrlInput = view.findViewById(R.id.search_engine_url);
+
+        // Add text watchers to enable/disable the Add button based on input validity
+        TextWatcher textWatcher = new TextWatcher() {
+            @Override
+            public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
+
+            @Override
+            public void onTextChanged(CharSequence s, int start, int before, int count) {}
+
+            @Override
+            public void afterTextChanged(Editable s) {
+                updateAddButtonState();
+            }
+        };
+
+        mNameInput.addTextChangedListener(textWatcher);
+        mKeywordInput.addTextChangedListener(textWatcher);
+        mSearchUrlInput.addTextChangedListener(textWatcher);
+
+        mDialog = new AlertDialog.Builder(context)
+                .setTitle(R.string.add_custom_search_engine_title)
+                .setView(view)
+                .setPositiveButton(android.R.string.ok, (dialog, which) -> addSearchEngine())
+                .setNegativeButton(android.R.string.cancel, null)
+                .create();
+
+        mDialog.setOnShowListener(dialogInterface -> updateAddButtonState());
+
+        return mDialog;
+    }
+
+    private void updateAddButtonState() {
+        if (mDialog == null) return;
+
+        boolean isValid = isInputValid();
+        mDialog.getButton(AlertDialog.BUTTON_POSITIVE).setEnabled(isValid);
+    }
+
+    private boolean isInputValid() {
+        String name = mNameInput.getText().toString().trim();
+        String keyword = mKeywordInput.getText().toString().trim();
+        String searchUrl = mSearchUrlInput.getText().toString().trim();
+
+        if (name.isEmpty() || keyword.isEmpty() || searchUrl.isEmpty()) {
+            return false;
+        }
+
+        // URL must contain %s or {searchTerms} placeholder
+        if (!searchUrl.contains("%s") && !searchUrl.contains("{searchTerms}")) {
+            return false;
+        }
+
+        // Basic URL validation
+        if (!searchUrl.startsWith("http://") && !searchUrl.startsWith("https://")) {
+            return false;
+        }
+
+        return true;
+    }
+
+    private void addSearchEngine() {
+        String name = mNameInput.getText().toString().trim();
+        String keyword = mKeywordInput.getText().toString().trim();
+        String searchUrl = mSearchUrlInput.getText().toString().trim();
+
+        // Convert %s to {searchTerms} format if needed
+        if (searchUrl.contains("%s")) {
+            searchUrl = searchUrl.replace("%s", "{searchTerms}");
+        }
+
+        TemplateUrlService templateUrlService = TemplateUrlServiceFactory.getForProfile(
+                ProfileManager.getLastUsedRegularProfile());
+
+        boolean success = templateUrlService.setPlayAPISearchEngine(
+                name,
+                keyword,
+                searchUrl,
+                null,  // suggestUrl
+                null,  // faviconUrl
+                null,  // newTabUrl
+                null,  // imageUrl
+                null,  // imageUrlPostParams
+                null,  // imageTranslateUrl
+                null,  // imageTranslateSourceLanguageParamKey
+                null); // imageTranslateTargetLanguageParamKey
+
+        if (success && mOnSuccessCallback != null) {
+            mOnSuccessCallback.run();
+        }
+    }
+}
