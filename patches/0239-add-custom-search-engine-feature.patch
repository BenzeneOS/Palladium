 package org.chromium.chrome.browser.search_engines.settings;
 
 
 import android.os.Bundle;
 import android.view.View;
+import android.widget.Button;
 import android.widget.ListView;
 
 import androidx.fragment.app.ListFragment;
 
 import org.chromium.base.supplier.ObservableSupplier;
@@ -76,10 +77,31 @@ public class SearchEngineSettings extends ListFragment
             View headerView =
                     getLayoutInflater()
                             .inflate(R.layout.search_engine_choice_header, listView, false);
             listView.addHeaderView(headerView);
         }
+
+        // Add footer with "Add custom search engine" button
+        View footerView =
+                getLayoutInflater()
+                        .inflate(R.layout.add_custom_search_engine_footer, listView, false);
+        Button addCustomButton = footerView.findViewById(R.id.add_custom_search_engine_button);
+        addCustomButton.setOnClickListener(v -> showAddCustomSearchEngineDialog());
+        listView.addFooterView(footerView);
+    }
+
+    private void showAddCustomSearchEngineDialog() {
+        AddCustomSearchEngineDialog dialog = new AddCustomSearchEngineDialog();
+        dialog.setOnSuccessCallback(() -> {
+            // Restart the adapter to refresh the list
+            // The TemplateUrlService observer will also trigger a refresh
+            if (mSearchEngineAdapter != null) {
+                mSearchEngineAdapter.stop();
+                mSearchEngineAdapter.start();
+            }
+        });
+        dialog.show(getParentFragmentManager(), "AddCustomSearchEngine");
     }
 
     @Override
     public void onStart() {
         super.onStart();

