 18 files changed, 74 insertions(+), 31 deletions(-)

diff --git a/chrome/browser/chrome_browser_field_trials.cc b/chrome/browser/chrome_browser_field_trials.cc
index edf55b0274167..1946bb638a25b 100644
--- a/chrome/browser/chrome_browser_field_trials.cc
+++ b/chrome/browser/chrome_browser_field_trials.cc
@@ -280,10 +280,15 @@ void ChromeBrowserFieldTrials::RegisterFeatureOverrides(
 
   // Suppress fallback to the legacy Android edge glow shade on Desktop Android.
   feature_overrides.EnableFeature(features::kSuppressOverscrollGlow);
 
 #endif  // BUILDFLAG(IS_DESKTOP_ANDROID)
+#if BUILDFLAG(IS_DESKTOP_ANDROID_VANADIUM)
+  // TabsEventRouter CHECKs a tab's WebContents, which lazily restored tabs do
+  // not have, so extensions require every tab to be loaded at startup.
+  feature_overrides.EnableFeature(chrome::android::kLoadAllTabsAtStartup);
+#endif
   // Desktop-first features which are past incubation should either end up here,
   // or to a finch trial that enables it for all form factors.
 #endif  // BUILDFLAG(IS_ANDROID)
 }
 
