+package org.chromium.components.browser_ui.accessibility;
+
+import org.chromium.base.ContextUtils;
+
+/**
+ * Utility class for edge swipe navigation settings.
+ *
+ * Provides three modes:
+ * - disabled: No edge swipe navigation
+ * - back_only: Left edge swipe goes back (default Chrome behavior)
+ * - back_and_forward: Left edge = back, Right edge = forward
+ */
+public class EdgeSwipeNavigationUtils {
+    private static final String PREF_KEY = "edge_swipe_navigation_mode";
+
+    public static final String MODE_DISABLED = "disabled";
+    public static final String MODE_BACK_ONLY = "back_only";
+    public static final String MODE_BACK_AND_FORWARD = "back_and_forward";
+
+    // Default to back_and_forward for better UX
+    private static final String DEFAULT_MODE = MODE_BACK_AND_FORWARD;
+
+    /**
+     * Get the current edge swipe navigation mode.
+     * @return One of MODE_DISABLED, MODE_BACK_ONLY, or MODE_BACK_AND_FORWARD
+     */
+    public static String getEdgeSwipeNavigationMode() {
+        return ContextUtils.getAppSharedPreferences().getString(PREF_KEY, DEFAULT_MODE);
+    }
+
+    /**
+     * Set the edge swipe navigation mode.
+     * @param mode One of MODE_DISABLED, MODE_BACK_ONLY, or MODE_BACK_AND_FORWARD
+     */
+    public static void setEdgeSwipeNavigationMode(String mode) {
+        ContextUtils.getAppSharedPreferences().edit().putString(PREF_KEY, mode).apply();
+    }
+
+    /**
+     * Check if edge swipe navigation is enabled at all.
+     * @return true if any edge swipe navigation is enabled
+     */
+    public static boolean isEdgeSwipeEnabled() {
+        String mode = getEdgeSwipeNavigationMode();
+        return !MODE_DISABLED.equals(mode);
+    }
+
+    /**
