+    private @Nullable Token getContainerGroupToken() {
+        if (isIncognito()) return null;
+        if (!ChromeFeatureList.isEnabled(ChromeFeatureList.PALLADIUM_TAB_GROUP_CONTAINERS)) {
+            return null;
+        }
+        return getTabGroupId();
+    }
+
+    // Every WebContents this tab creates for itself must come through here, so a grouped tab
+    // always lands in its group's container partition.
+    private WebContents createWebContentsMaybeInContainer(
+            boolean initiallyHidden, boolean initializeRenderer) {
+        Token groupToken = getContainerGroupToken();
+        if (groupToken != null) {
+            return WebContentsFactory.createWebContentsForTabGroupContainer(
+                    mProfile, groupToken, initiallyHidden, initializeRenderer);
+        }
+        return WebContentsFactory.createWebContents(mProfile, initiallyHidden, initializeRenderer);
+    }
