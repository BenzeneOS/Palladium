+package org.chromium.chrome.browser.tab;
+
+import org.chromium.base.Log;
+import org.chromium.base.Token;
+import org.chromium.base.task.PostTask;
+import org.chromium.base.task.TaskTraits;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.content.WebContentsFactory;
+import org.chromium.chrome.browser.flags.ChromeFeatureList;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.tab_group_sync.TabGroupSyncServiceFactory;
+import org.chromium.chrome.browser.tabmodel.ChromeTabCreator;
+import org.chromium.chrome.browser.tabmodel.TabClosureParams;
+import org.chromium.chrome.browser.tabmodel.TabGroupObserver;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.tabmodel.TabModelObserver;
+import org.chromium.chrome.browser.ui.native_page.NativePage;
+import org.chromium.components.tab_group_sync.SavedTabGroup;
+import org.chromium.components.tab_group_sync.TabGroupSyncService;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.url.GURL;
+
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/**
+ * Keeps a tab's StoragePartition consistent with its tab group membership. A live tab whose
+ * partition no longer matches its group is replaced by a frozen twin created from its serialized
+ * state, whose activation restores into the correct partition through the standard restore path.
+ * Deleting a group for real wipes its partition, while hidden saved groups keep their storage so
+ * reopening restores the same identity.
+ */
+@NullMarked
+public class TabGroupContainerMigrator implements TabGroupObserver {
+
+    // Catches grouped tabs arriving through paths that fire no group event, like a
+    // recent-tabs reopen restoring into the default partition.
+    private final TabModelObserver mAddObserver =
+            new TabModelObserver() {
+                @Override
+                public void didAddTab(
+                        Tab tab,
+                        @TabLaunchType int type,
+                        @TabCreationState int creationState,
+                        boolean markedForSelection) {
+                    if (tab.getTabGroupId() != null) migrate(tab);
+                }
+
+                @Override
+                public void restoreCompleted() {
+                    registerExistingContainers();
+                }
+
+                @Override
+                public void onDestroy() {
+                    stopObservingSyncInitialization();
+                }
+            };
+    private static final String TAG = "TabGroupContainer";
+
+    // The value must not reference the key or WeakHashMap can never collect the entry.
+    private static final Map<TabModel, Boolean> sAttached = new WeakHashMap<>();
+
+    private final Map<Tab, Boolean> mWatchedNativePageTabs = new WeakHashMap<>();
+
+    private final Profile mProfile;
+    private final TabModel mTabModel;
+    private final ChromeTabCreator mTabCreator;
+    private final @Nullable TabGroupSyncService mSyncService;
+    private boolean mObservingSyncInitialization;
+    private final TabGroupSyncService.Observer mSyncInitObserver =
+            new TabGroupSyncService.Observer() {
+                @Override
+                public void onInitialized() {
+                    registerExistingContainers();
+                    stopObservingSyncInitialization();
+                }
+            };
+
+    private TabGroupContainerMigrator(
+            Profile profile, TabModel tabModel, ChromeTabCreator tabCreator) {
+        mProfile = profile;
+        mTabModel = tabModel;
+        mTabCreator = tabCreator;
+        mSyncService = TabGroupSyncServiceFactory.getForProfile(profile);
+        if (mSyncService != null) {
+            mObservingSyncInitialization = true;
+            mSyncService.addObserver(mSyncInitObserver);
+        }
+    }
+
+    /** Attaches a migrator to the given model once. Incognito already isolates and is skipped. */
+    public static void attach(TabModel tabModel, ChromeTabCreator tabCreator) {
+        Profile profile = tabModel.getProfile();
+        if (profile == null || profile.isOffTheRecord()) return;
+        WebContentsFactory.retryPendingTabGroupContainerWipes(profile);
+        if (!ChromeFeatureList.isEnabled(ChromeFeatureList.PALLADIUM_TAB_GROUP_CONTAINERS)) {
+            return;
+        }
+        if (sAttached.containsKey(tabModel)) return;
+        TabGroupContainerMigrator migrator =
+                new TabGroupContainerMigrator(profile, tabModel, tabCreator);
+        sAttached.put(tabModel, Boolean.TRUE);
+        tabModel.addTabGroupObserver(migrator);
+        tabModel.addObserver(migrator.mAddObserver);
+        migrator.registerExistingContainers();
+    }
+
+    private @Nullable Token containerTokenFor(Tab tab) {
+        if (tab.isIncognitoBranded()) return null;
+        return tab.getTabGroupId();
+    }
+
+    // Posted so the group mutation this reacts to has fully finished before the model changes
+    // again. Replacing the tab rather than rebuilding its WebContents in place keeps every
+    // upstream assumption about a live tab's WebContents lifetime intact.
+    private void migrate(@Nullable Tab tab) {
+        if (tab == null) return;
+        Token groupToken = containerTokenFor(tab);
+        if (groupToken != null) {
+            WebContentsFactory.registerTabGroupContainer(mProfile, groupToken);
+        }
+        PostTask.postTask(TaskTraits.UI_DEFAULT, () -> replaceTabIfWrongPartition(tab));
+    }
+
+    private void registerExistingContainers() {
+        for (Tab tab : mTabModel) {
+            Token groupToken = containerTokenFor(tab);
+            if (groupToken != null) {
+                WebContentsFactory.registerTabGroupContainer(mProfile, groupToken);
+            }
+        }
+
+        if (mSyncService == null) return;
+        for (String syncId : mSyncService.getAllGroupIds()) {
+            SavedTabGroup savedGroup = mSyncService.getGroup(syncId);
+            if (savedGroup != null && savedGroup.localId != null) {
+                WebContentsFactory.registerTabGroupContainer(
+                        mProfile, savedGroup.localId.tabGroupId);
+            }
+        }
+    }
+
+    private void stopObservingSyncInitialization() {
+        if (!mObservingSyncInitialization || mSyncService == null) return;
+        mObservingSyncInitialization = false;
+        mSyncService.removeObserver(mSyncInitObserver);
+    }
+
+    private void replaceTabIfWrongPartition(Tab tab) {
+        if (tab.isDestroyed() || tab.isIncognitoBranded()) return;
+        // Native pages hold no site storage and never keep the fixed partition.
+        if (tab.isNativePage()
+                || NativePage.isNativePageUrl(tab.getUrl(), tab.isIncognitoBranded(), false)) {
+            migrateAfterLeavingNativePage(tab);
+            return;
+        }
+        WebContents webContents = tab.getWebContents();
+        // A frozen tab restores into the correct partition on its own.
+        if (webContents == null) return;
+        if (WebContentsFactory.webContentsMatchesContainer(webContents, containerTokenFor(tab))) {
+            return;
+        }
+        TabState state = TabStateExtractor.from(tab);
+        if (state == null || state.contentsState == null) {
+            // The tab keeps the wrong partition, which is the exact failure this
+            // feature exists to prevent, so it must at least be visible.
+            Log.w(TAG, "Tab %d not migrated, state extraction failed", tab.getId());
+            assert false : "Tab state extraction failed during container migration";
+            return;
+        }
+        state.tabGroupId = tab.getTabGroupId();
+        boolean wasActive = mTabModel.getTabAt(mTabModel.index()) == tab;
+        int index = mTabModel.indexOf(tab);
+        Tab replacement = mTabCreator.createFrozenTab(state, Tab.INVALID_TAB_ID, index + 1);
+        if (replacement == null) return;
+        mTabModel
+                .getTabRemover()
+                .forceCloseTabs(TabClosureParams.closeTab(tab).allowUndo(false).build());
+        if (wasActive) {
+            mTabModel.setIndex(mTabModel.indexOf(replacement), TabSelectionType.FROM_USER);
+        }
+    }
+
+    private void migrateAfterLeavingNativePage(Tab tab) {
+        if (Boolean.TRUE.equals(mWatchedNativePageTabs.get(tab))) return;
+        mWatchedNativePageTabs.put(tab, Boolean.TRUE);
+        tab.addObserver(
+                new EmptyTabObserver() {
+                    @Override
+                    public void onPageLoadFinished(Tab watched, GURL url) {
+                        if (NativePage.isNativePageUrl(
+                                url, watched.isIncognitoBranded(), false)) {
+                            return;
+                        }
+                        watched.removeObserver(this);
+                        mWatchedNativePageTabs.remove(watched);
+                        if (watched.getTabGroupId() != null) migrate(watched);
+                    }
+
+                    @Override
+                    public void onDestroyed(Tab watched) {
+                        watched.removeObserver(this);
+                        mWatchedNativePageTabs.remove(watched);
+                    }
+                });
+    }
+
+    @Override
+    public void didCreateNewGroup(Tab destinationTab, TabModel tabModel) {
+        migrate(destinationTab);
+    }
+
+    @Override
+    public void didMergeTabToGroup(Tab movedTab, boolean isDestinationTab) {
+        migrate(movedTab);
+    }
+
+    @Override
+    public void didMoveTabOutOfGroup(Tab movedTab, int prevFilterIndex) {
+        migrate(movedTab);
+    }
+
+    @Override
+    public void didRemoveTabGroup(
+            int oldRootId,
+            @Nullable Token oldTabGroupId,
+            @TabGroupObserver.DidRemoveTabGroupReason int reason) {
+        // CLOSE waits for committedTabGroupClosure so an undone closure keeps its storage.
+        if (oldTabGroupId == null || reason == TabGroupObserver.DidRemoveTabGroupReason.CLOSE) {
+            return;
+        }
+        WebContentsFactory.wipeTabGroupContainer(mProfile, oldTabGroupId);
+    }
+
+    @Override
+    public void committedTabGroupClosure(Token tabGroupId, boolean wasHiding) {
+        // A hiding closure is a saved group that can reopen, so its identity stays.
+        if (wasHiding) return;
+        WebContentsFactory.wipeTabGroupContainer(mProfile, tabGroupId);
+    }
+}
