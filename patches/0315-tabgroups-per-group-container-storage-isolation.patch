+static ScopedJavaLocalRef<jobject>
+JNI_WebContentsFactory_CreateWebContentsForTabGroupContainer(
+    JNIEnv* env,
+    Profile* profile,
+    base::Token group_token,
+    bool initially_hidden,
+    bool initialize_renderer,
+    const JavaRef<jthrowable>& j_creator_location) {
+  RegisterTabGroupContainerPartition(profile, group_token);
+  // The per-group identity rides in partition_name, which is the group's
+  // unique token, so a recreated group never reuses a prior container's
+  // partition. On disk so the identity survives restarts.
+  auto site_instance = content::SiteInstance::CreateForFixedStoragePartition(
+      profile, GURL(), TabGroupContainerPartitionConfig(profile, group_token));
+
+  content::WebContents::CreateParams params =
+      content::WebContents::CreateParams(profile, std::move(site_instance));
+  params.initially_hidden = initially_hidden;
+  params.desired_renderer_state =
+      initialize_renderer
+          ? content::WebContents::CreateParams::
+                kInitializeAndWarmupRendererProcess
+          : content::WebContents::CreateParams::kOkayToHaveRendererProcess;
+  params.java_creator_location = j_creator_location;
+
+  // Ownership is passed into java, and then to TabAndroid::InitWebContents.
+  // No per-WebContents data deleter here. The partition is shared by every
+  // tab in the group and outlives any one of them. Cleanup happens at group
+  // deletion.
+  return content::WebContents::Create(params).release()->GetJavaWebContents();
+}
+
+static jboolean JNI_WebContentsFactory_WebContentsMatchesContainer(
+    JNIEnv* env,
+    const JavaRef<jobject>& j_web_contents,
+    const JavaRef<jobject>& j_group_token) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(j_web_contents);
+  if (!web_contents) {
+    return true;
+  }
+  auto actual = web_contents->GetSiteInstance()
+                    ->GetSecurityPrincipal()
+                    .GetStoragePartitionConfig();
+  content::BrowserContext* browser_context = web_contents->GetBrowserContext();
+  auto expected =
+      j_group_token
+          ? TabGroupContainerPartitionConfig(
+                browser_context, base::android::TokenAndroid::FromJavaToken(
+                                     env, j_group_token))
+          : content::StoragePartitionConfig::CreateDefault(browser_context);
+  return actual == expected;
+}
+
+static void JNI_WebContentsFactory_WipeTabGroupContainer(
+    JNIEnv* env,
+    Profile* profile,
+    base::Token group_token) {
+  WipeTabGroupContainerPartition(profile, group_token);
+}
+
+static void JNI_WebContentsFactory_RegisterTabGroupContainer(
+    JNIEnv* env,
+    Profile* profile,
+    base::Token group_token) {
+  RegisterTabGroupContainerPartition(profile, group_token);
+}
+
+static void JNI_WebContentsFactory_RetryPendingTabGroupContainerWipes(
+    JNIEnv* env,
+    Profile* profile) {
+  RetryPendingTabGroupContainerWipes(profile);
+}
