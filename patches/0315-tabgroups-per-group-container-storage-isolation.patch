diff --git a/chrome/browser/tab/tab_group_container_partition.cc b/chrome/browser/tab/tab_group_container_partition.cc
new file mode 100644
index 0000000000..80701c60aa
--- /dev/null
+++ b/chrome/browser/tab/tab_group_container_partition.cc
@@ -0,0 +1,208 @@
+// Copyright 2026 The Vanadium Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/tab/tab_group_container_partition.h"
+
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+
+#include "base/containers/flat_set.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_util.h"
+#include "base/supports_user_data.h"
+#include "base/time/time.h"
+#include "base/values.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/common/pref_names.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+#include "content/public/browser/storage_partition.h"
+#include "third_party/blink/public/common/storage_key/storage_key.h"
+
+namespace {
+
+constexpr char kPartitionDomain[] = "palladiumtabgroupcontainer";
+const int kWipeStateKey = 0;
+
+class WipeState : public base::SupportsUserData::Data {
+ public:
+  base::flat_set<std::string> in_flight_tokens;
+  base::flat_set<std::string> keep_registered_tokens;
+};
+
+std::string PartitionName(const base::Token& group_token) {
+  return base::ToLowerASCII(group_token.ToString());
+}
+
+std::optional<base::Token> ParseToken(const std::string& token_string) {
+  return base::Token::FromString(base::ToUpperASCII(token_string));
+}
+
+WipeState* GetWipeState(Profile* profile) {
+  auto* state = static_cast<WipeState*>(profile->GetUserData(&kWipeStateKey));
+  if (!state) {
+    auto new_state = std::make_unique<WipeState>();
+    state = new_state.get();
+    profile->SetUserData(&kWipeStateKey, std::move(new_state));
+  }
+  return state;
+}
+
+bool ListPrefContainsToken(Profile* profile,
+                           const char* pref_name,
+                           const base::Token& token) {
+  for (const base::Value& value : profile->GetPrefs()->GetList(pref_name)) {
+    const std::string* token_string = value.GetIfString();
+    if (token_string && ParseToken(*token_string) == token) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool AddTokenToListPref(Profile* profile,
+                        const char* pref_name,
+                        const base::Token& token) {
+  if (ListPrefContainsToken(profile, pref_name, token)) {
+    return false;
+  }
+  ScopedListPrefUpdate update(profile->GetPrefs(), pref_name);
+  update->Append(token.ToString());
+  return true;
+}
+
+void EraseTokenFromListPref(Profile* profile,
+                            const char* pref_name,
+                            const base::Token& token) {
+  ScopedListPrefUpdate update(profile->GetPrefs(), pref_name);
+  update->EraseIf([&token](const base::Value& value) {
+    const std::string* token_string = value.GetIfString();
+    return token_string && ParseToken(*token_string) == token;
+  });
+}
+
+void OnWipeFinished(base::WeakPtr<Profile> profile, base::Token group_token) {
+  if (!profile) {
+    return;
+  }
+
+  WipeState* state = GetWipeState(profile.get());
+  const std::string token_string = group_token.ToString();
+  state->in_flight_tokens.erase(token_string);
+  if (!state->keep_registered_tokens.erase(token_string)) {
+    EraseTokenFromListPref(
+        profile.get(), prefs::kTabGroupContainerPartitionTokens, group_token);
+  }
+  EraseTokenFromListPref(
+      profile.get(), prefs::kTabGroupContainerPendingWipeTokens, group_token);
+  profile->GetPrefs()->CommitPendingWrite();
+}
+
+void StartWipe(Profile* profile, const base::Token& group_token) {
+  if (profile->ShutdownStarted()) {
+    return;
+  }
+  WipeState* state = GetWipeState(profile);
+  if (!state->in_flight_tokens.insert(group_token.ToString()).second) {
+    return;
+  }
+
+  content::StoragePartition* partition = profile->GetStoragePartition(
+      TabGroupContainerPartitionConfig(profile, group_token));
+  partition->ClearData(
+      content::StoragePartition::REMOVE_DATA_MASK_ALL, blink::StorageKey(),
+      base::Time(), base::Time::Max(),
+      base::BindOnce(&OnWipeFinished, profile->GetWeakPtr(), group_token));
+}
+
+void OnWipeJournalCommitted(base::WeakPtr<Profile> profile,
+                            base::Token group_token) {
+  if (!profile || !ListPrefContainsToken(
+                      profile.get(), prefs::kTabGroupContainerPendingWipeTokens,
+                      group_token)) {
+    return;
+  }
+  StartWipe(profile.get(), group_token);
+}
+
+void AddTokensFromPref(Profile* profile,
+                       const char* pref_name,
+                       base::flat_set<std::string>* tokens) {
+  for (const base::Value& value : profile->GetPrefs()->GetList(pref_name)) {
+    const std::string* token_string = value.GetIfString();
+    if (!token_string) {
+      continue;
+    }
+    std::optional<base::Token> token = ParseToken(*token_string);
+    if (token) {
+      tokens->insert(token->ToString());
+    }
+  }
+}
+
+}  // namespace
+
+content::StoragePartitionConfig TabGroupContainerPartitionConfig(
+    content::BrowserContext* browser_context,
+    const base::Token& group_token) {
+  return content::StoragePartitionConfig::Create(
+      browser_context, kPartitionDomain, PartitionName(group_token), false);
+}
+
+void RegisterTabGroupContainerPartition(Profile* profile,
+                                        const base::Token& group_token) {
+  if (ListPrefContainsToken(profile, prefs::kTabGroupContainerPendingWipeTokens,
+                            group_token)) {
+    GetWipeState(profile)->keep_registered_tokens.insert(
+        group_token.ToString());
+  }
+  if (AddTokenToListPref(profile, prefs::kTabGroupContainerPartitionTokens,
+                         group_token)) {
+    profile->GetPrefs()->CommitPendingWrite();
+  }
+}
+
+std::vector<content::StoragePartitionConfig>
+GetRegisteredTabGroupContainerPartitions(Profile* profile) {
+  std::vector<content::StoragePartitionConfig> partitions;
+  base::flat_set<std::string> token_strings;
+  AddTokensFromPref(profile, prefs::kTabGroupContainerPartitionTokens,
+                    &token_strings);
+  AddTokensFromPref(profile, prefs::kTabGroupContainerPendingWipeTokens,
+                    &token_strings);
+  partitions.reserve(token_strings.size());
+  for (const std::string& token_string : token_strings) {
+    std::optional<base::Token> token = ParseToken(token_string);
+    if (token) {
+      partitions.push_back(TabGroupContainerPartitionConfig(profile, *token));
+    }
+  }
+  return partitions;
+}
+
+void WipeTabGroupContainerPartition(Profile* profile,
+                                    const base::Token& group_token) {
+  GetWipeState(profile)->keep_registered_tokens.erase(group_token.ToString());
+  AddTokenToListPref(profile, prefs::kTabGroupContainerPartitionTokens,
+                     group_token);
+  AddTokenToListPref(profile, prefs::kTabGroupContainerPendingWipeTokens,
+                     group_token);
+  profile->GetPrefs()->CommitPendingWrite(base::BindOnce(
+      &OnWipeJournalCommitted, profile->GetWeakPtr(), group_token));
+}
+
+void RetryPendingTabGroupContainerWipes(Profile* profile) {
+  base::flat_set<std::string> token_strings;
+  AddTokensFromPref(profile, prefs::kTabGroupContainerPendingWipeTokens,
+                    &token_strings);
+  for (const std::string& token_string : token_strings) {
+    std::optional<base::Token> token = ParseToken(token_string);
+    if (token) {
+      StartWipe(profile, *token);
+    }
+  }
+}
